{
  "name": "hiremate-ai",
  "version": "0.1.0",
  "private": true,
  "description": "Full-stack recruitment and AI-powered interview platform",
  "packageManager": "pnpm@10.14.0",
  "scripts": {
    "dev": "pnpm --parallel --filter @hiremate/web --filter @hiremate/api dev",
    "build": "pnpm --filter @hiremate/web build",
    "build:web": "pnpm --filter @hiremate/web build",
    "build:all": "pnpm -r build",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "db:generate": "pnpm --filter @hiremate/database db:generate",
    "db:push": "pnpm --filter @hiremate/database db:push"
  },
  "engines": {
    "node": ">=20"
  }
}
