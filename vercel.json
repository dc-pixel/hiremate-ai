{
  "framework": "nextjs",
  "installCommand": "corepack enable && pnpm install --no-frozen-lockfile",
  "buildCommand": "pnpm --filter @hiremate/web build",
  "devCommand": "pnpm --filter @hiremate/web dev",
  "ignoreCommand": "git diff --quiet HEAD^ HEAD ./apps/web ./packages ./package.json ./pnpm-workspace.yaml ./vercel.json"
}
